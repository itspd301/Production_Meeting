@model KpiMasterIndexViewModel
@{
    ViewData["Title"] = "KPI Master";
}

<div class="pm-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">KPI Master</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Add KPI
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-6 col-md-3">
            <select name="plantId" id="filterPlantId" class="form-select" onchange="this.form.submit()">
                <option value="">All Plants</option>
                @foreach (var p in Model.Plants)
                {
                    <option value="@p.Id" selected="@(Model.PlantId == p.Id)">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3">
            <select name="lineId" class="form-select" onchange="this.form.submit()">
                <option value="">All Shops</option>
                @foreach (var l in Model.Lines)
                {
                    <option value="@l.Id" selected="@(Model.LineId == l.Id)">@l.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-8 col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Search description or indicator..." value="@Model.Search" />
        </div>
        <div class="col-sm-4 col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Plant</th>
                    <th>Shop</th>
                    <th>Indicator</th>
                    <th>Unit</th>
                    <th>Description</th>
                    <th>Order</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted">No KPIs found.</td></tr>
                }
                @foreach (var k in Model.Items)
                {
                    <tr>
                        <td>@k.PlantName</td>
                        <td>@k.LineName</td>
                        <td><span class="pm-indicator-cell pm-ind-@k.IndicatorCode d-inline-block px-2 py-1 rounded">@k.IndicatorCode</span> @k.IndicatorName</td>
                        <td>@k.UnitName</td>
                        <td>@k.Description</td>
                        <td>@k.DisplayOrder</td>
                        <td>
                            @{
                                var sourceClass = k.Source == KpiSources.StoredProcedure ? "pm-source-sp" : k.Source == KpiSources.Calculated ? "pm-source-calculated" : "pm-source-manual";
                            }
                            <span class="pm-source-tag @sourceClass">@(k.Source ?? KpiSources.Manual)</span>
                        </td>
                        <td><span class="pm-badge-status @(k.IsActive ? "status-green" : "status-red")">@(k.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@k.KpiId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil-square"></i></a>
                            <button type="button" class="btn btn-sm @(k.IsActive ? "btn-outline-danger" : "btn-outline-success") pm-toggle-active" data-id="@k.KpiId" data-active="@k.IsActive.ToString().ToLower()">
                                <i class="bi @(k.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm mb-0">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-route-page="@i" asp-route-plantId="@Model.PlantId" asp-route-lineId="@Model.LineId" asp-route-search="@Model.Search">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        $('.pm-toggle-active').on('click', function () {
            var $btn = $(this);
            var id = $btn.data('id');
            var newActive = !$btn.data('active');
            pmConfirm('Are you sure you want to ' + (newActive ? 'activate' : 'deactivate') + ' this KPI?', function () {
                $.post('@Url.Action("SetActive")', { id: id, isActive: newActive }, function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        setTimeout(function () { window.location.reload(); }, 700);
                    } else {
                        toastr.error(res.message);
                    }
                });
            });
        });
    </script>
}
