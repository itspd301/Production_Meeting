@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
    var statusCode = ViewBag.StatusCode as string;
    var notProvisioned = User.Identity?.IsAuthenticated == true && !User.IsProvisioned();
}

<div class="pm-auth-wrapper">
    <div class="pm-auth-card text-center">
        @if (notProvisioned)
        {
            <i class="bi bi-person-fill-lock text-warning" style="font-size:3rem;"></i>
            <h2 class="mt-3">Account Not Registered</h2>
            <p class="text-muted">
                You're signed in to Windows as <strong>@User.Identity?.Name</strong>, but this account
                hasn't been registered in Production Meeting yet.
            </p>
            <p class="text-muted small">Ask an administrator to add your account under User Management.</p>
        }
        else if (statusCode == "404")
        {
            <i class="bi bi-signpost-2 text-secondary" style="font-size:3rem;"></i>
            <h2 class="mt-3">Page Not Found</h2>
            <p class="text-muted">The page you're looking for doesn't exist.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
        }
        else
        {
            <i class="bi bi-shield-lock text-danger" style="font-size:3rem;"></i>
            <h2 class="mt-3">Access Denied</h2>
            <p class="text-muted">You do not have permission to view this page.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
        }
    </div>
</div>
