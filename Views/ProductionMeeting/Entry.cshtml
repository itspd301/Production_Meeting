@model MeetingEntryViewModel
@{
    ViewData["Title"] = "Meeting Entry";
}

<div class="pm-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="mb-1">@Model.PlantName &raquo; @Model.LineName</h5>
            <div class="text-muted small">
                @PmDates.WeekLabel(Model.MeetingDate)
                <span class="pm-badge-status @(Model.Status == "Completed" ? "status-green" : "status-amber") ms-2">@Model.Status</span>
            </div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>
    </div>
</div>

<input type="hidden" id="sessionId" value="@Model.SessionId" />

<div class="pm-card mb-3">
    <h6 class="mb-3">KPI Scorecard</h6>
    <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle pm-entry-table">
            <thead class="table-light">
                <tr>
                    <th style="width:70px;">Ind.</th>
                    <th style="min-width:220px;">Description</th>
                    <th>Unit</th>
                    <th>Model</th>
                    <th style="width:110px;">F26</th>
                    <th style="width:110px;">F27 / L4 Target</th>
                    <th style="width:100px;">Week</th>
                    <th style="width:110px;">Month Cum.</th>
                    <th style="width:100px;">YTD</th>
                    <th style="min-width:180px;">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.IndicatorGroups)
                {
                    for (var i = 0; i < group.Rows.Count; i++)
                    {
                        var row = group.Rows[i];
                        var isReadOnly = Model.ReadOnly || row.IsReadOnlySource;
                        <tr class="pm-kpi-row" data-kpi-id="@row.KpiId" data-sp="@row.IsReadOnlySource.ToString().ToLower()">
                            @if (i == 0)
                            {
                                <td rowspan="@group.Rows.Count" class="pm-indicator-cell pm-ind-@group.IndicatorCode" title="@group.IndicatorName">
                                    @group.IndicatorCode
                                </td>
                            }
                            <td>
                                @row.Description
                                @if (row.IsReadOnlySource)
                                {
                                    <span class="pm-source-tag pm-source-sp" title="Populated automatically via stored procedure - not editable here">SP</span>
                                }
                            </td>
                            <td>@row.UnitName</td>
                            <td>
                                <select class="form-select form-select-sm pm-f-model" @(isReadOnly ? "disabled" : "")>
                                    <option value="">-</option>
                                    @foreach (var m in Model.Models)
                                    {
                                        <option value="@m.Id" selected="@(row.ModelId == m.Id)">@m.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-f26" value="@row.F26Value" @(isReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-f27" value="@row.F27Value" @(isReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-week" value="@row.WeekValue" @(isReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-month" value="@row.MonthCumValue" @(isReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-ytd" value="@row.YtdValue" @(isReadOnly ? "readonly" : "") /></td>
                            <td><input type="text" class="form-control form-control-sm pm-f-remarks" value="@row.Remarks" @(isReadOnly ? "readonly" : "") /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mb-0">
        <span class="pm-source-tag pm-source-sp">SP</span> KPIs are populated automatically by the plant's stored procedure and can't be edited here.
        Use the <kbd>&uarr;</kbd> <kbd>&darr;</kbd> arrow keys to move between cells in the same column.
    </p>
</div>

@if (!Model.ReadOnly)
{
    <div class="d-flex justify-content-end gap-2 mb-4">
        <button type="button" id="btnSaveDraft" class="btn btn-outline-primary">
            <i class="bi bi-save"></i> Save Draft
        </button>
        <button type="button" id="btnComplete" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Save &amp; Mark Completed
        </button>
    </div>
}

@section Scripts {
    <script>
        function collectRows() {
            var rows = [];
            $('.pm-kpi-row').each(function () {
                var $row = $(this);
                if ($row.data('sp')) return; // SP-sourced rows are never sent for save

                rows.push({
                    kpiId: parseInt($row.data('kpi-id'), 10),
                    modelId: $row.find('.pm-f-model').val() ? parseInt($row.find('.pm-f-model').val(), 10) : null,
                    f26Value: $row.find('.pm-f-f26').val() || null,
                    f27Value: $row.find('.pm-f-f27').val() || null,
                    weekValue: $row.find('.pm-f-week').val() || null,
                    monthCumValue: $row.find('.pm-f-month').val() || null,
                    ytdValue: $row.find('.pm-f-ytd').val() || null,
                    remarks: $row.find('.pm-f-remarks').val() || null
                });
            });
            return rows;
        }

        function saveEntry(markCompleted) {
            pmShowLoader();

            var payload = {
                sessionId: parseInt($('#sessionId').val(), 10),
                markCompleted: markCompleted,
                rows: collectRows()
            };

            pmFetch('@Url.Action("SaveEntry")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    pmHideLoader();
                    if (res.success) {
                        toastr.success(res.message || 'Saved successfully');
                        if (markCompleted) {
                            setTimeout(function () { window.location.href = '@Url.Action("Index")'; }, 900);
                        }
                    } else {
                        toastr.error(res.message || 'Save failed');
                    }
                })
                .catch(function () {
                    pmHideLoader();
                    toastr.error('An error occurred while saving.');
                });
        }

        $('#btnSaveDraft').on('click', function () { saveEntry(false); });
        $('#btnComplete').on('click', function () {
            pmConfirm('Mark this meeting as completed? You will no longer be able to edit it.', function () {
                saveEntry(true);
            });
        });

        // Excel-style Up/Down cell navigation: move focus to the same column in the row
        // above/below instead of the browser's native number-input spinner behavior.
        $('.pm-entry-table').on('keydown', '.pm-f-f26, .pm-f-f27, .pm-f-week, .pm-f-month, .pm-f-ytd, .pm-f-remarks', function (e) {
            if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
            e.preventDefault();

            var $cell = $(this);
            var colClass = $cell.attr('class').split(/\s+/).find(function (c) { return c.indexOf('pm-f-') === 0; });
            var $row = $cell.closest('tr');
            var $targetRow = e.key === 'ArrowUp'
                ? $row.prevAll('tr.pm-kpi-row').first()
                : $row.nextAll('tr.pm-kpi-row').first();

            if ($targetRow.length) {
                var $target = $targetRow.find('.' + colClass);
                if ($target.length) {
                    $target.trigger('focus').select();
                }
            }
        });
    </script>
}
