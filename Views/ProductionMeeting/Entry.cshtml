@model MeetingEntryViewModel
@{
    ViewData["Title"] = "Meeting Entry";
}

<div class="pm-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="mb-1">@Model.PlantName &raquo; @Model.LineName</h5>
            <div class="text-muted small">
                @PmDates.WeekLabel(Model.MeetingDate)
                <span class="pm-badge-status @(Model.Status == "Completed" ? "status-green" : "status-amber") ms-2">@Model.Status</span>
            </div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>
    </div>
</div>

<input type="hidden" id="sessionId" value="@Model.SessionId" />

<div class="pm-card mb-3">
    <h6 class="mb-3">KPI Scorecard</h6>
    <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle pm-entry-table">
            <thead class="table-light">
                <tr>
                    <th style="width:70px;">Ind.</th>
                    <th style="min-width:220px;">Description</th>
                    <th>Unit</th>
                    <th style="width:110px;">@Model.F26Label</th>
                    <th style="width:110px;">@Model.F27Label</th>
                    <th style="width:100px;">Week</th>
                    <th style="width:110px;">Month Cum.</th>
                    <th style="width:100px;">YTD</th>
                    <th style="min-width:180px;">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.IndicatorGroups)
                {
                    for (var i = 0; i < group.Rows.Count; i++)
                    {
                        var row = group.Rows[i];
                        var isReadOnly = Model.ReadOnly;
                        <tr class="pm-kpi-row" data-kpi-id="@row.KpiId">
                            @if (i == 0)
                            {
                                <td rowspan="@group.Rows.Count" class="pm-indicator-cell pm-ind-@group.IndicatorCode" title="@group.IndicatorName">
                                    @group.IndicatorCode
                                </td>
                            }
                            <td>@row.Description</td>
                            <td>@row.UnitName</td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-f26" value="@row.F26Value" data-master-value="@row.MasterF26Value" @(isReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-f27" value="@row.F27Value" data-master-value="@row.MasterF27Value" @(isReadOnly ? "readonly" : "") /></td>
                            <td>
                                <input type="number" step="1" class="form-control form-control-sm pm-f-week" value="@row.WeekValue" @(isReadOnly ? "readonly" : "") />
                                @if (row.IsSpSourced)
                                {
                                    <i class="bi bi-database-gear text-muted" title="Auto-filled from stored procedure - you can still edit it"></i>
                                }
                            </td>
                            <td class="pm-f-month text-end">@row.MonthCumValue</td>
                            <td class="pm-f-ytd text-end">@row.YtdValue</td>
                            <td><input type="text" class="form-control form-control-sm pm-f-remarks" value="@row.Remarks" @(isReadOnly ? "readonly" : "") /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mb-0">
        Use the <kbd>&uarr;</kbd> <kbd>&darr;</kbd> arrow keys to move between cells in the same column. Month Cum. and YTD are calculated automatically from Week values.
    </p>
</div>

@if (!Model.ReadOnly)
{
    <div class="d-flex justify-content-end gap-2 mb-4">
        <button type="button" id="btnSaveDraft" class="btn btn-outline-primary">
            <i class="bi bi-save"></i> Save
        </button>
        <button type="button" id="btnComplete" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Save &amp; Mark Completed
        </button>
    </div>
}

@section Scripts {
    <script>
        function collectRows() {
            var rows = [];
            $('.pm-kpi-row').each(function () {
                var $row = $(this);
                rows.push({
                    kpiId: parseInt($row.data('kpi-id'), 10),
                    f26Value: $row.find('.pm-f-f26').val() || null,
                    f27Value: $row.find('.pm-f-f27').val() || null,
                    weekValue: $row.find('.pm-f-week').val() || null,
                    remarks: $row.find('.pm-f-remarks').val() || null
                });
            });
            return rows;
        }

        function saveEntry(markCompleted) {
            pmShowLoader();

            var payload = {
                sessionId: parseInt($('#sessionId').val(), 10),
                markCompleted: markCompleted,
                rows: collectRows()
            };

            pmFetch('@Url.Action("SaveEntry")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    pmHideLoader();
                    if (res.success) {
                        toastr.success(res.message || 'Saved successfully');
                        (res.rows || []).forEach(function (r) {
                            var $row = $('.pm-kpi-row[data-kpi-id="' + r.kpiId + '"]');
                            $row.find('.pm-f-month').text(r.monthCumValue != null ? r.monthCumValue : '');
                            $row.find('.pm-f-ytd').text(r.ytdValue != null ? r.ytdValue : '');
                        });
                        if (markCompleted) {
                            setTimeout(function () { window.location.href = '@Url.Action("Index")'; }, 900);
                        }
                    } else {
                        toastr.error(res.message || 'Save failed');
                    }
                })
                .catch(function () {
                    pmHideLoader();
                    toastr.error('An error occurred while saving.');
                });
        }

        $('#btnSaveDraft').on('click', function () { saveEntry(false); });
        $('#btnComplete').on('click', function () {
            pmConfirm('Mark this meeting as completed? You will no longer be able to edit it.', function () {
                saveEntry(true);
            });
        });

        // F26/F27 are normally fixed for the whole year (set in KPI Master). Editing one
        // here only overrides this single week, so confirm before letting it stick - and
        // revert back to the yearly value if the popup gets dismissed instead of confirmed.
        $('.pm-entry-table').on('change', '.pm-f-f26, .pm-f-f27', function () {
            var $input = $(this);
            var masterValue = $input.data('master-value');
            var masterStr = (masterValue === undefined || masterValue === null || masterValue === '') ? '' : String(masterValue);
            var previousValue = $input.data('prev-value') !== undefined ? $input.data('prev-value') : masterStr;

            if ($input.val() === masterStr) {
                $input.data('prev-value', $input.val());
                return;
            }

            var newValue = $input.val();
            var confirmed = false;
            pmConfirm('This value is normally fixed for the year (set in KPI Master). Override it for this week only?', function () {
                confirmed = true;
                $input.data('prev-value', newValue);
            });
            $('#pmConfirmModal').one('hidden.bs.modal', function () {
                if (!confirmed) {
                    $input.val(previousValue);
                }
            });
        });
        $('.pm-f-f26, .pm-f-f27').each(function () { $(this).data('prev-value', $(this).val()); });

        // Excel-style Up/Down cell navigation: move focus to the same column in the row
        // above/below instead of the browser's native number-input spinner behavior.
        $('.pm-entry-table').on('keydown',
        '.pm-f-f26, .pm-f-f27, .pm-f-week, .pm-f-remarks',
        function (e) {

            if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key))
                return;

            e.preventDefault();

            var columns = [
                'pm-f-f26',
                'pm-f-f27',
                'pm-f-week',
                'pm-f-remarks'
            ];

            var $cell = $(this);
            var $row = $cell.closest('tr');

            var currentCol = columns.find(function (c) {
                return $cell.hasClass(c);
            });

            var currentIndex = columns.indexOf(currentCol);

            // UP / DOWN
            if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {

                var $targetRow = e.key === 'ArrowUp'
                    ? $row.prevAll('tr.pm-kpi-row').first()
                    : $row.nextAll('tr.pm-kpi-row').first();

                if ($targetRow.length) {
                    var $target = $targetRow.find('.' + currentCol);
                    if ($target.length) {
                        $target.focus().select?.();
                    }
                }
            }

            // LEFT
            if (e.key === 'ArrowLeft' && currentIndex > 0) {
                var $target = $row.find('.' + columns[currentIndex - 1]);
                $target.focus().select?.();
            }

            // RIGHT
            if (e.key === 'ArrowRight' && currentIndex < columns.length - 1) {
                var $target = $row.find('.' + columns[currentIndex + 1]);
                $target.focus().select?.();
            }
        });
    </script>
}
