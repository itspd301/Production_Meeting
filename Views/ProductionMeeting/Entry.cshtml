@model MeetingEntryViewModel
@{
    ViewData["Title"] = "Meeting Entry";
}

<div class="pm-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="mb-1">@Model.PlantName &raquo; @Model.LineName</h5>
            <div class="text-muted small">
                @Model.MeetingDate.ToString("dd-MMM-yyyy")
                <span class="pm-badge-status @(Model.Status == "Completed" ? "status-green" : "status-amber") ms-2">@Model.Status</span>
            </div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>
    </div>
</div>

<input type="hidden" id="sessionId" value="@Model.SessionId" />

<div class="pm-card mb-3">
    <h6 class="mb-3">KPI Scorecard</h6>
    <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle pm-entry-table">
            <thead class="table-light">
                <tr>
                    <th style="width:70px;">Ind.</th>
                    <th style="min-width:220px;">Description</th>
                    <th>Unit</th>
                    <th>Model</th>
                    <th style="width:110px;">F26</th>
                    <th style="width:110px;">F27 / L4 Target</th>
                    <th style="width:100px;">Week</th>
                    <th style="width:110px;">Month Cum.</th>
                    <th style="width:100px;">YTD</th>
                    <th style="min-width:180px;">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.IndicatorGroups)
                {
                    for (var i = 0; i < group.Rows.Count; i++)
                    {
                        var row = group.Rows[i];
                        <tr class="pm-kpi-row" data-kpi-id="@row.KpiId">
                            @if (i == 0)
                            {
                                <td rowspan="@group.Rows.Count" class="pm-indicator-cell pm-ind-@group.IndicatorCode" title="@group.IndicatorName">
                                    @group.IndicatorCode
                                </td>
                            }
                            <td>@row.Description</td>
                            <td>@row.UnitName</td>
                            <td>
                                <select class="form-select form-select-sm pm-f-model" @(Model.ReadOnly ? "disabled" : "")>
                                    <option value="">-</option>
                                    @foreach (var m in Model.Models)
                                    {
                                        <option value="@m.Id" selected="@(row.ModelId == m.Id)">@m.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-f26" value="@row.F26Value" @(Model.ReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-f27" value="@row.F27Value" @(Model.ReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-week" value="@row.WeekValue" @(Model.ReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-month" value="@row.MonthCumValue" @(Model.ReadOnly ? "readonly" : "") /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm pm-f-ytd" value="@row.YtdValue" @(Model.ReadOnly ? "readonly" : "") /></td>
                            <td><input type="text" class="form-control form-control-sm pm-f-remarks" value="@row.Remarks" @(Model.ReadOnly ? "readonly" : "") /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.ReadOnly)
{
    <div class="d-flex justify-content-end gap-2 mb-4">
        <button type="button" id="btnSaveDraft" class="btn btn-outline-primary">
            <i class="bi bi-save"></i> Save Draft
        </button>
        <button type="button" id="btnComplete" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Save &amp; Mark Completed
        </button>
    </div>
}

@section Scripts {
    <script>
        function collectRows() {
            var rows = [];
            $('.pm-kpi-row').each(function () {
                var $row = $(this);
                rows.push({
                    kpiId: parseInt($row.data('kpi-id'), 10),
                    modelId: $row.find('.pm-f-model').val() ? parseInt($row.find('.pm-f-model').val(), 10) : null,
                    f26Value: $row.find('.pm-f-f26').val() || null,
                    f27Value: $row.find('.pm-f-f27').val() || null,
                    weekValue: $row.find('.pm-f-week').val() || null,
                    monthCumValue: $row.find('.pm-f-month').val() || null,
                    ytdValue: $row.find('.pm-f-ytd').val() || null,
                    remarks: $row.find('.pm-f-remarks').val() || null
                });
            });
            return rows;
        }

        function saveEntry(markCompleted) {
            pmShowLoader();

            var payload = {
                sessionId: parseInt($('#sessionId').val(), 10),
                markCompleted: markCompleted,
                rows: collectRows()
            };

            pmFetch('@Url.Action("SaveEntry")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    pmHideLoader();
                    if (res.success) {
                        toastr.success(res.message || 'Saved successfully');
                        if (markCompleted) {
                            setTimeout(function () { window.location.href = '@Url.Action("Index")'; }, 900);
                        }
                    } else {
                        toastr.error(res.message || 'Save failed');
                    }
                })
                .catch(function () {
                    pmHideLoader();
                    toastr.error('An error occurred while saving.');
                });
        }

        $('#btnSaveDraft').on('click', function () { saveEntry(false); });
        $('#btnComplete').on('click', function () {
            pmConfirm('Mark this meeting as completed? You will no longer be able to edit it.', function () {
                saveEntry(true);
            });
        });
    </script>
}
