@model MeetingIndexViewModel
@{
    ViewData["Title"] = "Production Meeting";
    var canEnter = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.ProductionUser);
}

@if (canEnter)
{
    <div class="pm-card mb-3">
        <h5 class="mb-3">Start / Continue a Meeting</h5>
        <form asp-action="Entry" method="get" class="row g-2 align-items-end" id="startEntryForm">
            <div class="col-sm-6 col-md-3">
                <label class="form-label">Plant</label>
                <select name="plantId" id="startPlantId" class="form-select" required>
                    <option value="">-- Select Plant --</option>
                    @foreach (var p in Model.Plants)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label">Shop</label>
                <select name="lineId" id="startLineId" class="form-select" required disabled>
                    <option value="">-- Select Plant First --</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label">Week</label>
                <input type="week" name="week" class="form-control" value="@Model.NewEntryWeek" required />
            </div>
            <div class="col-sm-6 col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-play-circle"></i> Open Entry
                </button>
            </div>
        </form>
    </div>
}

<div class="pm-card">
    <h5 class="mb-3">Meeting History</h5>

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-6 col-md-3">
            <select name="plantId" class="form-select" onchange="this.form.submit()">
                <option value="">All Plants</option>
                @foreach (var p in Model.Plants)
                {
                    <option value="@p.Id" selected="@(Model.PlantId == p.Id)">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3">
            <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" placeholder="From" />
        </div>
        <div class="col-sm-6 col-md-3">
            <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" placeholder="To" />
        </div>
        <div class="col-sm-6 col-md-3">
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (Model.Sessions.Count == 0)
    {
        <p class="text-muted mb-0">No meetings found for the selected filters.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Week</th>
                        <th>Plant</th>
                        <th>Shop</th>
                        <th>Conducted By</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Sessions)
                    {
                        <tr>
                            <td>@PmDates.WeekLabel(s.MeetingDate)</td>
                            <td>@s.PlantName</td>
                            <td>@s.LineName</td>
                            <td>@s.ConductedByName</td>
                            <td>@s.EnteredCount / @s.KpiCount KPIs</td>
                            <td>
                                <span class="pm-badge-status @(s.Status == "Completed" ? "status-green" : "status-amber")">@s.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-plantId="@Model.PlantId" asp-route-lineId="@Model.LineId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        $(function () {
            var $plant = $('#startPlantId');
            var $line = $('#startLineId');

            $plant.on('change', function () {
                var plantId = $(this).val();
                $line.prop('disabled', true).html('<option value="">Loading...</option>');

                if (!plantId) {
                    $line.html('<option value="">-- Select Plant First --</option>');
                    return;
                }

                $.get('@Url.Action("GetLines")', { plantId: plantId }, function (data) {
                    var options = '<option value="">-- Select Shop --</option>';
                    data.forEach(function (l) {
                        options += '<option value="' + l.lineId + '">' + l.name + '</option>';
                    });
                    $line.html(options).prop('disabled', false);
                }).fail(function () {
                    $line.html('<option value="">Failed to load shops</option>');
                });
            });
        });
    </script>
}
