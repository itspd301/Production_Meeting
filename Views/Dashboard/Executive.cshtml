@model ExecutiveDashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
    var plantName = Model.Plants.FirstOrDefault(p => p.Id == Model.PlantId).Name ?? "-";
    var lineName = Model.Lines.FirstOrDefault(l => l.Id == Model.LineId).Name ?? "-";
}

@section Styles {
    <style>
        :root {
            --xd-red: #d71920; --xd-red-dark: #a71219; --xd-navy: #122b49; --xd-navy-light: #1e4269;
            --xd-green: #1e8e5a; --xd-amber: #c98a1f; --xd-line: #e4e8ee; --xd-muted: #6b7785;
            --xd-bg: #eef1f6; --xd-shadow: 0 3px 14px rgba(18, 43, 73, .07);
        }
        .xd-app { max-width: 1920px; margin: 0 auto; background: var(--xd-bg); padding: 4px 4px 20px; border-radius: 16px; }

        .xd-header {
            display: grid; grid-template-columns: 220px 1fr auto; gap: 16px; align-items: center;
            background: linear-gradient(135deg, #fff 0%, #f7f9fc 100%); border: 1px solid var(--xd-line);
            border-radius: 16px; padding: 14px 20px; box-shadow: var(--xd-shadow); margin-bottom: 16px;
        }
        .xd-brand {
            height: 62px; background: linear-gradient(145deg,#ef1b24,#a71219); color: #fff; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 20px; font-weight: 800;
            letter-spacing: .3px; box-shadow: 0 6px 16px rgba(167,18,25,.28);
        }
        .xd-brand i { font-size: 26px; }
        .xd-title { text-align: center; }
        .xd-title h1 { font-size: 21px; margin: 0; color: #111827; font-weight: 800; letter-spacing: .2px; }
        .xd-title p { margin: 5px 0 0; color: var(--xd-muted); font-size: 12.5px; }
        .xd-filters { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; align-items: end; }
        .xd-filter { min-width: 138px; }
        .xd-filter label { font-size: 10.5px; font-weight: 600; color: var(--xd-muted); text-transform: uppercase; letter-spacing: .04em; display: block; margin-bottom: 4px; }
        .xd-filter select, .xd-filter input {
            width: 100%; padding: 7px 10px; border: 1px solid var(--xd-line); border-radius: 8px; background: #fff;
            font-size: 13px; transition: border-color .15s, box-shadow .15s;
        }
        .xd-filter select:focus, .xd-filter input:focus { outline: none; border-color: var(--xd-navy-light); box-shadow: 0 0 0 3px rgba(30,66,105,.12); }

        .xd-summary { display: grid; grid-template-columns: repeat(5,1fr); gap: 12px; margin-bottom: 16px; }
        .xd-pill {
            background: #fff; border: 1px solid var(--xd-line); border-left: 4px solid var(--xd-navy-light);
            border-radius: 12px; padding: 11px 14px; box-shadow: var(--xd-shadow); transition: transform .15s, box-shadow .15s;
        }
        .xd-pill:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(18,43,73,.1); }
        .xd-pill span { font-size: 10px; font-weight: 700; color: var(--xd-muted); text-transform: uppercase; letter-spacing: .05em; }
        .xd-pill b { display: block; font-size: 15px; margin-top: 3px; color: #1c2733; }

        .xd-group-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap: 14px; margin-bottom: 16px; }
        .xd-group {
            background: #fff; border: 1px solid var(--xd-line); border-radius: 14px; overflow: hidden;
            box-shadow: var(--xd-shadow); transition: box-shadow .2s;
        }
        .xd-group:hover { box-shadow: 0 8px 22px rgba(18,43,73,.12); }
        .xd-group-title {
            padding: 10px 14px; text-align: center; color: #fff; font-weight: 700; font-size: 12.5px;
            letter-spacing: .06em; text-transform: uppercase;
        }
        .xd-cards { display: grid; grid-template-columns: repeat(3,1fr); }
        .xd-kpi {
            position: relative; padding: 13px 10px 11px; border-right: 1px solid #eef0f3; border-top: 1px solid #eef0f3;
            min-height: 128px; cursor: pointer; transition: background .15s; border-top-width: 3px; border-top-style: solid;
        }
        .xd-kpi.green { border-top-color: var(--xd-green); }
        .xd-kpi.amber { border-top-color: var(--xd-amber); }
        .xd-kpi.red { border-top-color: var(--xd-red); }
        .xd-kpi.pending, .xd-kpi.notarget { border-top-color: #c3cad3; }
        .xd-kpi:hover { background: #f7f9fc; }
        .xd-kpi:nth-child(3n) { border-right: 0; }
        .xd-kpi-name { font-size: 10.5px; font-weight: 700; min-height: 28px; text-align: center; color: #33404d; line-height: 1.3; }
        .xd-value { text-align: center; font-weight: 800; font-size: 23px; margin: 4px 0 1px; color: #12202f; }
        .xd-unit { text-align: center; font-size: 9.5px; color: var(--xd-muted); }
        .xd-target { text-align: center; font-size: 10px; margin-top: 5px; color: var(--xd-muted); }
        .xd-dot { position: absolute; right: 9px; top: 12px; width: 9px; height: 9px; border-radius: 50%; box-shadow: 0 0 0 3px #fff; }
        .xd-dot.green, .xd-badge.green { background: var(--xd-green); }
        .xd-dot.amber, .xd-badge.amber { background: var(--xd-amber); }
        .xd-dot.red, .xd-badge.red { background: var(--xd-red); }
        .xd-dot.pending, .xd-badge.pending, .xd-dot.notarget, .xd-badge.notarget { background: #9aa4af; }
        .xd-mini { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; margin-top: 8px; border-top: 1px dashed #e5e9ee; padding-top: 6px; }
        .xd-mini div { text-align: center; font-size: 9px; color: var(--xd-muted); }
        .xd-mini b { display: block; font-size: 10.5px; color: #33404d; margin-top: 1px; }

        .xd-grid { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 14px; margin-bottom: 16px; }
        .xd-panel { background: #fff; border: 1px solid var(--xd-line); border-radius: 14px; padding: 14px; box-shadow: var(--xd-shadow); }
        .xd-panel h3 {
            font-size: 12px; font-weight: 700; color: var(--xd-navy); text-align: center; margin: 0 0 10px;
            text-transform: uppercase; letter-spacing: .05em; padding-bottom: 8px; border-bottom: 1px solid var(--xd-line);
        }
        .xd-chartbox { height: 250px; }

        .xd-narrative { display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 14px; margin-bottom: 16px; }
        .xd-note ul { margin: 8px 0 0; padding-left: 18px; font-size: 12.5px; line-height: 1.7; color: #33404d; }
        .xd-note ul li::marker { color: var(--xd-muted); }
        .xd-remark textarea {
            width: 100%; height: 88px; border: 1px solid var(--xd-line); border-radius: 10px; padding: 10px;
            resize: vertical; font-family: inherit; font-size: 13px; transition: border-color .15s, box-shadow .15s;
        }
        .xd-remark textarea:focus { outline: none; border-color: var(--xd-navy-light); box-shadow: 0 0 0 3px rgba(30,66,105,.12); }
        .xd-actions { display: flex; gap: 8px; margin-top: 9px; }

        .xd-table-wrap { overflow: auto; border-radius: 10px; border: 1px solid var(--xd-line); }
        .xd-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .xd-table th, .xd-table td { padding: 9px 10px; border-bottom: 1px solid #eef0f3; text-align: right; }
        .xd-table th {
            background: var(--xd-navy); color: #fff; font-weight: 600; font-size: 10.5px; text-transform: uppercase;
            letter-spacing: .04em; position: sticky; top: 0;
        }
        .xd-table tbody tr:nth-child(even) { background: #f8fafc; }
        .xd-table tbody tr:hover { background: #eef3f9; }
        .xd-table th:first-child, .xd-table td:first-child, .xd-table th:nth-child(2), .xd-table td:nth-child(2) { text-align: left; }
        .xd-badge { display: inline-block; padding: 3px 10px; border-radius: 999px; color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .03em; }

        .xd-footer {
            padding: 10px 16px; font-size: 11px; color: var(--xd-muted); display: flex; justify-content: space-between;
            flex-wrap: wrap; gap: 10px; background: #fff; border: 1px solid var(--xd-line); border-radius: 12px;
        }
        .xd-legend span { margin-left: 14px; }
        .xd-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; }

        .xd-modal { display: none; position: fixed; inset: 0; background: rgba(15,25,40,.55); align-items: center; justify-content: center; z-index: 1050; }
        .xd-modal.open { display: flex; }
        .xd-modal-card { width: min(640px,92vw); background: #fff; border-radius: 16px; padding: 20px; box-shadow: 0 24px 60px rgba(0,0,0,.3); }
        .xd-modal-head { display: flex; justify-content: space-between; align-items: start; }
        .xd-modal-head h4 { font-weight: 800; color: var(--xd-navy); }
        .xd-modal-close { font-size: 26px; cursor: pointer; border: 0; background: none; line-height: 1; color: var(--xd-muted); }
        .xd-modal-close:hover { color: var(--xd-red); }
        .xd-modal-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin: 14px 0; }
        .xd-modal-metric { background: #f7f9fc; border-radius: 10px; padding: 11px; text-align: center; }
        .xd-modal-metric span { font-size: 10px; color: var(--xd-muted); display: block; text-transform: uppercase; letter-spacing: .04em; }
        .xd-modal-metric b { font-size: 18px; color: #12202f; }
        .xd-modal-chart { height: 240px; }

        .xd-empty { text-align: center; color: var(--xd-muted); font-size: 12.5px; padding: 30px 10px; }
        .xd-sample-tag {
            font-size: 9px; font-weight: 700; color: #fff; background: #9aa4af; padding: 2px 9px;
            border-radius: 999px; letter-spacing: .04em; text-transform: uppercase; vertical-align: middle;
        }

        @@media (max-width: 1300px) { .xd-grid { grid-template-columns: 1fr 1fr; } }
        @@media (max-width: 1100px) { .xd-header { grid-template-columns: 1fr; text-align: center; } .xd-filters { justify-content: center; } .xd-grid, .xd-narrative, .xd-summary { grid-template-columns: 1fr 1fr; } }
        @@media (max-width: 720px) { .xd-grid, .xd-narrative, .xd-summary, .xd-cards { grid-template-columns: 1fr; } }
        @@media print { .xd-filters, .xd-actions, .pm-sidebar, .pm-header { display: none !important; } }
    </style>
}

<div class="xd-app">
    <header class="xd-header">
        <div class="xd-brand"><i class="bi bi-building-gear"></i> Mahindra</div>
        <div class="xd-title">
            <h1>PLANT HEAD PRODUCTION MEETING &mdash; @plantName.ToUpper() @lineName.ToUpper()</h1>
            <p>Weekly executive review dashboard</p>
        </div>
        <form method="get" class="xd-filters">
            <div class="xd-filter">
                <label>Plant</label>
                <select name="plantId" onchange="this.form.submit()">
                    @foreach (var p in Model.Plants)
                    {
                        <option value="@p.Id" selected="@(Model.PlantId == p.Id)">@p.Name</option>
                    }
                </select>
            </div>
            <div class="xd-filter">
                <label>Shop</label>
                <select name="lineId" onchange="this.form.submit()">
                    @foreach (var l in Model.Lines)
                    {
                        <option value="@l.Id" selected="@(Model.LineId == l.Id)">@l.Name</option>
                    }
                </select>
            </div>
            <div class="xd-filter">
                <label>Week</label>
                <input type="week" name="week" value="@Model.Week" onchange="this.form.submit()" />
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
            <a asp-action="Index" asp-route-plantId="@Model.PlantId" asp-route-lineId="@Model.LineId" class="btn btn-primary btn-sm"><i class="bi bi-arrow-left-right"></i> Classic View</a>
        </form>
    </header>

    @if (!Model.HasPlantAndShop)
    {
        <div class="xd-panel"><p class="text-muted mb-0">No plant/shop available. Ask an administrator to grant you access under User Management.</p></div>
    }
    else
    {
        <div class="text-end mb-1"><span class="xd-sample-tag">Sample data - pending SP</span></div>
        <section class="xd-summary">
            <div class="xd-pill"><span>Financial Year</span><b>@Model.SummaryFyLabel</b></div>
            <div class="xd-pill"><span>Selected Week</span><b>@Model.SummaryWeekLabel</b></div>
            <div class="xd-pill"><span>Week Dates</span><b>@Model.SummaryWeekDates</b></div>
            <div class="xd-pill"><span>Data Status</span><b style="color:var(--xd-green)">&#9679; @Model.SummaryDataStatus</b></div>
            <div class="xd-pill"><span>Last Refreshed</span><b>@Model.SummaryLastRefreshed</b></div>
        </section>

        <div class="xd-group-row">
            @foreach (var group in Model.Groups)
            {
                var barColor = group.IndicatorCode switch
                {
                    "S" => "linear-gradient(135deg,#d71920,#a71219)",
                    "Q" => "linear-gradient(135deg,#1e4269,#122b49)",
                    "C" => "linear-gradient(135deg,#1e8e5a,#146840)",
                    "D" => "linear-gradient(135deg,#2b6ca3,#18527a)",
                    "P" => "linear-gradient(135deg,#71a34a,#5c8a3a)",
                    "SUST" => "linear-gradient(135deg,#14939f,#0f7d8c)",
                    "M" => "linear-gradient(135deg,#d9a02a,#b66900)",
                    _ => "linear-gradient(135deg,#5b6b7c,#4b5563)"
                };
                <section class="xd-group">
                    <div class="xd-group-title" style="background:@barColor">@group.IndicatorName</div>
                    <div class="xd-cards">
                        @foreach (var k in group.Kpis)
                        {
                            var dotClass = k.Status.ToLower();
                            <div class="xd-kpi @dotClass" data-kpi-id="@k.KpiId" data-kpi-name="@k.Description">
                                <i class="xd-dot @dotClass"></i>
                                <div class="xd-kpi-name">@k.Description</div>
                                <div class="xd-unit">@k.UnitName</div>
                                <div class="xd-value">@(k.Value?.ToString("0.##") ?? "-")</div>
                                <div class="xd-target">Target: @(k.Target?.ToString("0.##") ?? "-")</div>
                                <div class="xd-mini">
                                    <div>WoW<b>@(k.WeekOverWeek?.ToString("0.##") ?? "-")</b></div>
                                    <div>MTD<b>@(k.MonthCumValue?.ToString("0.##") ?? "-")</b></div>
                                    <div>YTD<b>@(k.YtdValue?.ToString("0.##") ?? "-")</b></div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <section class="xd-grid">
            <div class="xd-panel"><h3><i class="bi bi-graph-up"></i> Weekly Trend &mdash; Quality &amp; Delivery <span class="xd-sample-tag">Sample</span></h3><div class="xd-chartbox"><canvas id="trendChart"></canvas></div></div>
            <div class="xd-panel">
                <h3><i class="bi bi-bar-chart-steps"></i> Top 5 Rework Defects &mdash; This Week <span class="xd-sample-tag">Sample</span></h3>
                @if (Model.TopDefects.Count == 0)
                {
                    <div class="xd-empty">
                        No defect breakdown recorded yet.<br />
                        Add entries like <code>DDS 150 RPT; Bolt torque 63 RPT</code> in a Rework KPI's Remarks to see this chart.
                    </div>
                }
                else
                {
                    <div class="xd-chartbox"><canvas id="defectChart"></canvas></div>
                }
            </div>
            <div class="xd-panel"><h3><i class="bi bi-people"></i> Manpower Deployed <span class="xd-sample-tag">Sample</span></h3><div class="xd-chartbox"><canvas id="manpowerChart"></canvas></div></div>
        </section>

        <section class="xd-panel mb-3">
            <h3><i class="bi bi-table"></i> Weekly KPI Summary</h3>
            <div class="xd-table-wrap">
                <table class="xd-table">
                    <thead>
                        <tr><th>Category</th><th>KPI</th><th>Unit</th><th>Target</th><th>Week</th><th>Status</th><th>Prev.</th><th>&Delta;</th><th>MTD</th><th>YTD</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.Groups)
                        {
                            foreach (var k in group.Kpis)
                            {
                                <tr>
                                    <td>@group.IndicatorName</td>
                                    <td>@k.Description</td>
                                    <td>@k.UnitName</td>
                                    <td>@(k.Target?.ToString("0.##") ?? "-")</td>
                                    <td>@(k.Value?.ToString("0.##") ?? "-")</td>
                                    <td><span class="xd-badge @k.Status.ToLower()">@k.Status</span></td>
                                    <td>@(k.PreviousValue?.ToString("0.##") ?? "-")</td>
                                    <td>@(k.WeekOverWeek?.ToString("0.##") ?? "-")</td>
                                    <td>@(k.MonthCumValue?.ToString("0.##") ?? "-")</td>
                                    <td>@(k.YtdValue?.ToString("0.##") ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="xd-narrative">
            <div class="xd-panel xd-note">
                <h3 style="color:var(--xd-green);text-align:left;border-bottom-color:transparent"><i class="bi bi-check-circle"></i> Highlights <span class="xd-sample-tag">Sample</span></h3>
                @if (Model.Highlights.Count == 0)
                {
                    <p class="text-muted small mb-0">No KPIs on target yet this week.</p>
                }
                else
                {
                    <ul>
                        @foreach (var h in Model.Highlights)
                        {
                            <li>@h.Description: @(h.Value?.ToString("0.##")) against @(h.Target?.ToString("0.##")) target.</li>
                        }
                    </ul>
                }
            </div>
            <div class="xd-panel xd-note">
                <h3 style="color:var(--xd-red);text-align:left;border-bottom-color:transparent"><i class="bi bi-exclamation-triangle"></i> Lowlights <span class="xd-sample-tag">Sample</span></h3>
                @if (Model.Lowlights.Count == 0)
                {
                    <p class="text-muted small mb-0">No red-status KPIs this week.</p>
                }
                else
                {
                    <ul>
                        @foreach (var l in Model.Lowlights)
                        {
                            <li>@l.Description: @(l.Value?.ToString("0.##")) against @(l.Target?.ToString("0.##")) target.</li>
                        }
                    </ul>
                }
            </div>
            <div class="xd-panel xd-remark">
                <h3 style="color:var(--xd-navy);text-align:left;border-bottom-color:transparent"><i class="bi bi-pencil-square"></i> Remarks &mdash; This Week</h3>
                <textarea id="remarksText" @(Model.CanEditRemarks && Model.SessionId.HasValue ? "" : "readonly")>@Model.SessionRemarks</textarea>
                @if (Model.CanEditRemarks && Model.SessionId.HasValue)
                {
                    <div class="xd-actions">
                        <button class="btn btn-primary btn-sm" onclick="saveRemarks()"><i class="bi bi-save"></i> Save Remarks</button>
                    </div>
                }
                else if (!Model.SessionId.HasValue)
                {
                    <p class="text-muted small mt-2 mb-0">Start this week's meeting first to add remarks.</p>
                }
            </div>
        </section>

        <div class="xd-footer">
            <span>Figures reflect data entered through Production Meeting for the selected plant, shop and week.</span>
            <span class="xd-legend">
                <span><i style="background:var(--xd-green)"></i>Achieved</span>
                <span><i style="background:var(--xd-amber)"></i>At Risk</span>
                <span><i style="background:var(--xd-red)"></i>Not Achieved</span>
            </span>
        </div>
    }
</div>

<div class="xd-modal" id="xdModal">
    <div class="xd-modal-card">
        <div class="xd-modal-head">
            <h4 id="xdModalTitle" class="mb-0"></h4>
            <button type="button" class="xd-modal-close" onclick="closeKpiModal()">&times;</button>
        </div>
        <div class="xd-modal-grid" id="xdModalMetrics"></div>
        <div class="xd-modal-chart"><canvas id="xdModalChart"></canvas></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        var trendLabels = @Html.Raw(Json.Serialize(Model.TrendWeekLabels));
        var trendSeries = @Html.Raw(Json.Serialize(Model.TrendSeries));
        var manpowerSeries = @Html.Raw(Json.Serialize(Model.ManpowerSeries));
        var defectLabels = @Html.Raw(Json.Serialize(Model.TopDefects.Select(d => d.Name)));
        var defectValues = @Html.Raw(Json.Serialize(Model.TopDefects.Select(d => d.Count)));
        var palette = ['#d71920', '#122b49', '#1e8e5a', '#8e44ad', '#c98a1f', '#0f7d8c'];

        function makeChart(id, labels, series, type) {
            var el = document.getElementById(id);
            if (!el || !labels || !labels.length) return;
            new Chart(el, {
                type: type || 'line',
                data: {
                    labels: labels,
                    datasets: series.map(function (s, i) {
                        return {
                            label: s.label,
                            data: s.values,
                            borderColor: palette[i % palette.length],
                            backgroundColor: palette[i % palette.length],
                            tension: .3
                        };
                    })
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { boxWidth: 10, font: { size: 10 } } } } }
            });
        }

        makeChart('trendChart', trendLabels, trendSeries, 'line');
        makeChart('manpowerChart', trendLabels, manpowerSeries, 'bar');

        if (defectLabels.length) {
            new Chart(document.getElementById('defectChart'), {
                type: 'bar',
                data: {
                    labels: defectLabels,
                    datasets: [{ data: defectValues, backgroundColor: '#d71920', borderRadius: 4 }]
                },
                options: {
                    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { ticks: { font: { size: 10 } } }, y: { ticks: { font: { size: 10 } } } }
                }
            });
        }

        $('.xd-kpi').on('click', function () {
            openKpiModal($(this).data('kpi-id'), $(this).data('kpi-name'));
        });

        var xdModalChart;
        function openKpiModal(kpiId, name) {
            document.getElementById('xdModalTitle').textContent = name;
            document.getElementById('xdModal').classList.add('open');

            pmFetch('@Url.Action("GetKpiTrend")?kpiId=' + kpiId + '&plantId=@Model.PlantId&lineId=@Model.LineId&week=@Model.Week')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var last = data.points.length ? data.points[data.points.length - 1].value : null;
                    var prev = data.points.length > 1 ? data.points[data.points.length - 2].value : null;
                    document.getElementById('xdModalMetrics').innerHTML = [
                        ['Current', last != null ? last : '-'],
                        ['Target', data.target != null ? data.target : '-'],
                        ['Previous', prev != null ? prev : '-'],
                        ['Unit', data.unitName]
                    ].map(function (x) {
                        return '<div class="xd-modal-metric"><span>' + x[0] + '</span><b>' + x[1] + '</b></div>';
                    }).join('');

                    if (xdModalChart) xdModalChart.destroy();
                    xdModalChart = new Chart(document.getElementById('xdModalChart'), {
                        type: 'line',
                        data: {
                            labels: data.points.map(function (p) { return p.weekLabel; }),
                            datasets: [
                                { label: name, data: data.points.map(function (p) { return p.value; }), borderColor: '#d71920', backgroundColor: '#d71920', tension: .3 },
                                { label: 'Target', data: data.points.map(function () { return data.target; }), borderColor: '#1e8e5a', borderDash: [6, 5], pointRadius: 0 }
                            ]
                        },
                        options: { responsive: true, maintainAspectRatio: false }
                    });
                });
        }

        function closeKpiModal() {
            document.getElementById('xdModal').classList.remove('open');
        }

        document.getElementById('xdModal').addEventListener('click', function (e) {
            if (e.target.id === 'xdModal') closeKpiModal();
        });

        function saveRemarks() {
            pmFetch('@Url.Action("SaveRemarks")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'sessionId=@Model.SessionId&remarks=' + encodeURIComponent(document.getElementById('remarksText').value)
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) toastr.success(res.message);
                    else toastr.error(res.message);
                });
        }
    </script>
}
