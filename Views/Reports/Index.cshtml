@model ReportIndexViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="pm-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">KPI History Report</h5>
        <a asp-action="Export"
           asp-route-plantId="@Model.PlantId" asp-route-lineId="@Model.LineId" asp-route-indicatorId="@Model.IndicatorId"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
           class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-6 col-md-2">
            <select name="plantId" id="filterPlantId" class="form-select" onchange="this.form.submit()">
                <option value="">All Plants</option>
                @foreach (var p in Model.Plants)
                {
                    <option value="@p.Id" selected="@(Model.PlantId == p.Id)">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-2">
            <select name="lineId" class="form-select" onchange="this.form.submit()">
                <option value="">All Lines</option>
                @foreach (var l in Model.Lines)
                {
                    <option value="@l.Id" selected="@(Model.LineId == l.Id)">@l.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-2">
            <select name="indicatorId" class="form-select" onchange="this.form.submit()">
                <option value="">All Indicators</option>
                @foreach (var i in Model.Indicators)
                {
                    <option value="@i.Id" selected="@(Model.IndicatorId == i.Id)">@i.Code &mdash; @i.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-2">
            <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" placeholder="From" />
        </div>
        <div class="col-sm-6 col-md-2">
            <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" placeholder="To" />
        </div>
        <div class="col-sm-6 col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th><th>Plant</th><th>Line</th><th>Ind.</th><th>KPI</th><th>Unit</th><th>Model</th>
                    <th>F26</th><th>F27</th><th>Week</th><th>Month Cum.</th><th>YTD</th><th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="13" class="text-center text-muted">No data found for the selected filters.</td></tr>
                }
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.MeetingDate.ToString("dd-MMM-yyyy")</td>
                        <td>@r.PlantName</td>
                        <td>@r.LineName</td>
                        <td><span class="pm-indicator-cell pm-ind-@r.IndicatorCode d-inline-block px-2 py-1 rounded">@r.IndicatorCode</span></td>
                        <td>@r.KpiDescription</td>
                        <td>@r.UnitName</td>
                        <td>@(r.ModelName ?? "-")</td>
                        <td>@r.F26Value</td>
                        <td>@r.F27Value</td>
                        <td>@r.WeekValue</td>
                        <td>@r.MonthCumValue</td>
                        <td>@r.YtdValue</td>
                        <td>@r.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm mb-0">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-route-page="@i" asp-route-plantId="@Model.PlantId" asp-route-lineId="@Model.LineId"
                           asp-route-indicatorId="@Model.IndicatorId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
